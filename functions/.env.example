# Copy to functions/.env before deploying. Never commit functions/.env.
# Emails that get the organizer tools (comma-separated).
ADMIN_EMAILS=coach@example.org,parent.helper@gmail.com
# manual = sponsors pay the team's own accounts and organizers confirm it (default). mock = test payments only; never deploy it.
PAYMENT_MODE=manual
# The platform's percentage of each payment, 0-20. Always disclosed to sponsors when above 0.
PLATFORM_FEE_PERCENT=0
# yes = tally the fee on payment-app, cash and check payments for invoicing the team. no = only card payments carry the fee.
FEE_ON_LINK_PAYMENTS=no
# Emails (both use Resend). Organizers in ADMIN_EMAILS get an evening summary at 6:30 p.m. team time on days
# something's waiting: notes opening tomorrow, updates to approve, payments to confirm, double bookings.
# Update emails: when a coach approves an athlete's update, sponsors who opted in get an email linking to her page.
# Off until both of these are set. Get a free key at resend.com and verify your sending domain there.
RESEND_API_KEY=
# The site's public address, no trailing slash. Used for the page link and the stop link in each email.
SITE_URL=https://yourteam.sendyourstrength.com
# Who the email is from. Must be on the domain you verified in Resend.
MAIL_FROM=Your Team Name via Send Your Strength <updates@sendyourstrength.com>
